# Copy this file to .env.local for local development.
# On Vercel, add the same keys under Project Settings > Environment Variables.

# Public origin of the deployment, without a trailing slash.
# Used for canonical URLs and social preview metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Address that every "Start a Conversation" button writes to.
NEXT_PUBLIC_CONTACT_EMAIL=connect@sagework.in
